# Variables del docker-compose LOCAL. Copiar a .env (ignorado por Git) y cambiar.
# Sin .env el compose usa estos mismos valores por defecto, que solo valen en local.
# Los secretos de la app (APIs de proveedores, JWT, Zoho) van en config/.env
# (plantilla: config/claves_example.env), nunca aquí ni en el repo.

MYSQL_ROOT_PASSWORD=cambiar-en-local
MYSQL_DATABASE=esc
MYSQL_USER=escuser
MYSQL_PASSWORD=cambiar-en-local
# Ojo: usuario y contraseña deben coincidir con config/conexion.json, y MySQL solo
# los aplica al crear el volumen (cambiarlos después exige recrearlo o un ALTER USER).

# 1 = no se habla con el Zoho CRM real (local y pruebas). En producción NO se define.
ZOHO_DESACTIVADO=1
