vendor/
config/conexion.json
config/smtp.json
config/jwt.env
config/.env
img/
webhook_data.txt
# Volcados de base de datos (no versionar): llevan datos reales de clientes
db_init/*.sql
*.sql
*.sql.gz
# ...pero las migraciones SI se versionan. El *.sql de arriba tambien se las tragaba,
# y sin ellas el despliegue queda a medias: sin la tabla api_cache, por ejemplo,
# Sigenergy responde 400 en todas las llamadas.
!db_migrations/*.sql
listar_apikeys.php

# Cache de resultados de PHPUnit (local, no aporta nada al repo)
.phpunit.result.cache

# Bruno - environment con credenciales reales (no versionar)
bruno/environments/*.bru
!bruno/environments/*.example.bru

# Helper local de login (lleva credenciales por defecto)
bin_codigo_login.sh

# Cache de Python de las pruebas de integracion: no pinta nada en el repo
# (ademas rompe los git stash/checkout al regenerarse en cada ejecucion).
__pycache__/
*.pyc

# Ficheros con secretos/datos reales que estuvieron versionados por error y se
# purgaron de la historia con git filter-repo (2026-07). NO volver a versionarlos.
*.ppk
*.pem
clases/conexion.json
storage/clavesInstanciaEsc.ppk
storage/infoApisEsc.txt
storage/cookies_seguras.txt
storage/ec2Config.txt
storage/usuarios_base.json
storage/usuarios_base.txt
