RewriteEngine On

# Asegurar que index.php sea el archivo por defecto
DirectoryIndex index.php

# NUNCA SERVIR FICHEROS INTERNOS. Antes se servia todo lo que no fuera .json/.php/.txt
# con listado de directorios activo: config/.env (claves JWT), .git/config (credencial
# de GitHub), docker-compose.yml, Bruno, scripts... Se responde 404, sin delatar nada.
# Solo se mira la peticion original: en la segunda pasada (tras reescribir a
# app/routers/rutas.php) las reglas de abajo bloquearian al propio router.
RewriteCond %{ENV:REDIRECT_STATUS} !^$
RewriteRule ^ - [L]
# - Cualquier ruta con un segmento oculto (.env, .git/, .gitleaks.toml...).
RewriteRule (^|/)\. - [R=404,L]
# - Carpetas que no son publicas (storage solo expone las capturas del frontend).
RewriteRule ^(config|vendor|testing|bruno|db_init|db_migrations|documentacion|docker|idiomas|app/(cron|DBObjects|models|services|controllers|middlewares|routers|proveedores|utils/(?!img/)))(/|$) - [R=404,L]
RewriteCond %{REQUEST_URI} !^/storage/img_screens_frontend/
RewriteRule ^storage(/|$) - [R=404,L]
# - Configuracion, volcados, scripts y documentacion sueltos.
RewriteRule \.(env|bru|sql|gz|sh|py|ya?ml|neon|lock|md|toml|ini|conf|dist|bak|log|ppk|pem|key|apk|xml)$ - [R=404,L]
RewriteRule ^(Dockerfile[^/]*|VERSION|composer\.json|prueba\.json)$ - [R=404,L]

# PERMITIR LISTADO DE DIRECTORIOS SOLO EN storage/img_screens_frontend
RewriteCond %{REQUEST_URI} ^/storage/img_screens_frontend/
RewriteRule ^ - [L]

Options -Indexes
<If "%{REQUEST_URI} =~ m#^/storage/img_screens_frontend/#">
    Options +Indexes
</If>
Require all granted

#ARCHIVOS PROHIBIDOS

<Files "conexion.json">
    Require all denied
</Files>
<Files "smtp.json">
    Require all denied
</Files>

#Denegamos el acceso a todo menos index.php y rutas.php

<FilesMatch "\.(json|css|js|pdf|php|txt)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|gif|bmp|webp|svg)$">
    Require all granted
</FilesMatch>

<Files "index.php">
    Require all granted
</Files>

<Files "obtener_imagen.php">
    Require all granted
</Files>

<Files "webhookgithub.php">
    Require all granted
</Files>

<Files "verificar.php">
    Require all granted
</Files>

<Files "rutas.php">
    Require all granted
</Files>

<Files "ayudaForm.php">
    Require all granted
</Files>

<Files "captcha.php">
    Require all granted
</Files>

#CORS
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

#Permitir que los archivos .html se accedan sin la extensión y con ella
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*?)/?$ $1.html [L,QSA]

#Permitir que los archivos .php se accedan sin la extensión y con ella
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.php -f
RewriteRule ^(.*?)/?$ $1.php [L,QSA]

# Redirigir peticiones a la raíz con ?page= a index.php
RewriteCond %{QUERY_STRING} ^page= [NC]
RewriteRule ^/?$ index.php [L,QSA]

#Redirigir todo lo demás a rutas.php para manejo de rutas en la API
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^.*$ app/routers/rutas.php [L,QSA]

