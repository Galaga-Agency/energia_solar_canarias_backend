meta {
  name: 05 - Proveedores
  type: http
  seq: 5
}

get {
  url: {{base_url_esc}}/proveedores
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{esc_jwt}}
}

docs {
  Lista de proveedores soportados (solo admin):
  goodwe, solaredge, victronenergy, sungrow, sigenergy.

  Estos son los valores validos del query param `?proveedor=` del resto de endpoints.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
