meta {
  name: 13 - Plant Overview
  type: http
  seq: 13
}

get {
  url: {{base_url_esc}}/plant/overview/{{esc_plant_id}}?proveedor={{esc_proveedor}}
  body: none
  auth: none
}

params:query {
  proveedor: {{esc_proveedor}}
}

headers {
  Accept: application/json
  Authorization: Bearer {{esc_jwt}}
}

docs {
  Resumen general de la planta.

  Implementado para goodwe / solaredge / victronenergy.
  Sungrow y Sigenergy todavia NO tienen rama en este endpoint -> responden
  "El proveedor no es valido".
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
