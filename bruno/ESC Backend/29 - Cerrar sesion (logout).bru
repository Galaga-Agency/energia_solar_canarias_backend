meta {
  name: 29 - Cerrar sesion (logout)
  type: http
  seq: 29
}

post {
  url: {{base_url_esc}}/auth/logout
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Origin: {{base_url_esc}}
}

body:json {
  {}
}

docs {
  Revoca la sesion de la cookie (sus tokens de acceso y refresh dejan de valer al momento) y borra la cookie. Mismas exigencias que la 28.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
