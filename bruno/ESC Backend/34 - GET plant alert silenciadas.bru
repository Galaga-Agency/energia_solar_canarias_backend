meta {
  name: 34 - GET plant alert silenciadas
  type: http
  seq: 34
}

get {
  url: {{base_url_esc}}/plant/alert/silenciadas?proveedor={{esc_proveedor}}&plantaId={{esc_plant_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{esc_jwt}}
}

docs {
  Bearer; lee silencios locales.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
