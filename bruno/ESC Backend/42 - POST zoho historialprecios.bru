meta {
  name: 42 - POST zoho historialprecios
  type: http
  seq: 42
}

post {
  url: {{base_url_esc}}/zoho/historialprecios?plantId={{esc_plant_id}}&proveedor={{esc_proveedor}}
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Origin: {{base_url_esc}}
  Authorization: Bearer {{esc_jwt}}
}

body:json {
  {}
}

docs {
  Bearer admin; lectura de precios en Zoho.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
