meta {
  name: 46 - POST change password
  type: http
  seq: 46
}

post {
  url: {{base_url_esc}}/change/password
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Origin: {{base_url_esc}}
  Authorization: Bearer {{esc_jwt}}
}

body:json {
  {
    "token": "{{esc_recovery_token}}",
    "password": "{{esc_nueva_password}}"
  }
}

docs {
  Público con token de recuperación de un uso; modifica credencial. No ejecutar con cuentas reales.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
