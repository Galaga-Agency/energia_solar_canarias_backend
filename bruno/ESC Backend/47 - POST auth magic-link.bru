meta {
  name: 47 - POST auth magic-link
  type: http
  seq: 47
}

post {
  url: {{base_url_esc}}/auth/magic-link
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Origin: {{base_url_esc}}
  Authorization: Bearer {{esc_jwt}}
}

body:json {
  {
    "email": "{{esc_email}}",
    "idiomaUsuario": "es"
  }
}

docs {
  Público; envía enlace (Mailpit local). No revela si el email existe.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
