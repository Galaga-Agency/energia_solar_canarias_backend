meta {
  name: 48 - POST auth handoff
  type: http
  seq: 48
}

post {
  url: {{base_url_esc}}/auth/handoff
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Origin: {{base_url_esc}}
  Authorization: Bearer {{esc_jwt}}
}

body:json {
  {
    "code": "{{esc_handoff_code}}"
  }
}

docs {
  Público; canjea código de enlace por una sesión; un solo uso.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
