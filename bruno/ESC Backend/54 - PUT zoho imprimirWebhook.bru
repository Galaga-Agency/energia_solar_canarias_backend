meta {
  name: 54 - PUT zoho imprimirWebhook
  type: http
  seq: 54
}

put {
  url: {{base_url_esc}}/zoho/imprimirWebhook
  body: json
  auth: none
}

headers {
  Accept: application/json
  Content-Type: application/json
  Origin: {{base_url_esc}}
  Authorization: Bearer {{esc_jwt}}
}

body:json {
  {
    "test": true,
    "origen": "bruno-local"
  }
}

docs {
  Bearer admin; sobrescribe webhook_data.txt.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
