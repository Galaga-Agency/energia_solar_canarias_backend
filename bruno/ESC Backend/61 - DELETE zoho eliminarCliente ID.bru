meta {
  name: 61 - DELETE zoho eliminarCliente ID
  type: http
  seq: 61
}

delete {
  url: {{base_url_esc}}/zoho/eliminarCliente/{{esc_zoho_customer_id}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{esc_jwt}}
}
docs {
  Bearer admin; ruta desactivada; debe responder 501. No ejecuta Zoho.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
  if (bru.getEnvVar('esc_zoho_desactivado_confirmado') !== 'si') {
    throw new Error('Bloqueado: confirma que el backend local tiene ZOHO_DESACTIVADO=1 poniendo esc_zoho_desactivado_confirmado = si.');
  }
}
