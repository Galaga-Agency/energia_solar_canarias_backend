meta {
  name: 63 - DELETE usuarios relacionar
  type: http
  seq: 63
}

delete {
  url: {{base_url_esc}}/usuarios/relacionar?idusuario={{esc_cliente_user_id}}&idplanta={{esc_plant_id}}&proveedor={{esc_proveedor}}
  body: none
  auth: none
}

headers {
  Accept: application/json
  Authorization: Bearer {{esc_jwt}}
}
docs {
  Bearer admin; cambia relaciones locales.
}

script:pre-request {
  const target = String(bru.getEnvVar('base_url_esc') || '');
  const isLocal = /^https?:\/\/(localhost|127\.0\.0\.1|\[::1\])(:\d+)?(\/|$)/i.test(target);
  if (!isLocal) {
    throw new Error('Bloqueado: la colección del backend solo se puede ejecutar contra localhost.');
  }
}
