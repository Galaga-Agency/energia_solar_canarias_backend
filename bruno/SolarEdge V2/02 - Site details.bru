meta {
  name: 02 - Site details
  type: http
  seq: 3
}

get {
  url: {{base_url_solaredge_v2}}/sites/{{solaredge_site_id}}
  body: none
  auth: none
}

headers {
  X-API-Key: {{solaredge_v2_api_key}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  V1 site/{id}/details. Campos renombrados (systemSize -> peakPower, status -> activationStatus).
}
