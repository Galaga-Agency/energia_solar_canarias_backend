meta {
  name: 08 - Storage telemetry
  type: http
  seq: 9
}

get {
  url: {{base_url_solaredge_v2}}/sites/{{solaredge_site_id}}/storage/telemetry?from={{solaredge_from}}&to={{solaredge_to}}
  body: none
  auth: none
}

params:query {
  from: {{solaredge_from}}
  to: {{solaredge_to}}
}

headers {
  X-API-Key: {{solaredge_v2_api_key}}
  Accept: application/json
}

assert {
  res.status: eq 200
}

docs {
  V1 site/{id}/storageData. chargePower, dischargePower, stateOfEnergy, etc. Estado y temperatura en /storage/status.
}
