meta {
  name: 06 - Device List (inventario)
  type: http
  seq: 7
}

post {
  url: {{base_url_sungrow}}/openapi/getDeviceList
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-access-key: {{sungrow_secret_key}}
}

body:json {
  {
    "appkey": "{{sungrow_appkey}}",
    "sys_code": "901",
    "lang": "_en_US",
    "token": "{{sungrow_access_token}}",
    "ps_id": "{{sungrow_ps_id}}",
    "curPage": 1,
    "size": 100
  }
}

script:post-response {
  const list = res.body && res.body.result_data && res.body.result_data.pageList;
  if (list) {
    // Inversor = device_type 1 (Inverter) o 14 (Hybrid inverter), igual que el
    // backend (SungrowService::TIPOS_INVERSOR). OJO: el primer dispositivo de la
    // lista suele ser un Meter (tipo 7), que NO da series; hay que filtrar por tipo.
    const inv = list.find(d => [1, 14].includes(Number(d.device_type)));
    if (inv) {
      bru.setVar('sungrow_ps_key', inv.ps_key);
      console.log('sungrow_ps_key (inversor tipo ' + inv.device_type + ') = ' + inv.ps_key);
    } else {
      console.log('Sin inversor (tipo 1/14) en la lista; ps_key NO actualizado.');
    }
    console.log('Dispositivos: ' + list.map(d => d.device_type + ':' + d.ps_key).join(', '));
  }
}

docs {
  Equipos de la planta. Alimenta el endpoint /plant/inventario del backend.

  Inversor = `device_type` 1 (Inverter) o 14 (Hybrid inverter). El script guarda su
  `ps_key` en `sungrow_ps_key`, que es lo que necesitan los request 07 y 08 para las
  series. OJO: el primer dispositivo suele ser un Meter (tipo 7) que NO da series,
  por eso se filtra por tipo y no se coge el primero.
}
