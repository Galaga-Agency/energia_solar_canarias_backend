meta {
  name: 11 - Diagnostico Minute Data ventana del backend (dia)
  type: http
  seq: 12
}

post {
  url: {{base_url_sungrow}}/openapi/getDevicePointMinuteDataList
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  x-access-key: {{sungrow_secret_key}}
}

body:json {
  {
    "appkey": "{{sungrow_appkey}}",
    "sys_code": "901",
    "lang": "_en_US",
    "token": "{{sungrow_access_token}}",
    "ps_key_list": {{sungrow_diag_inv_keys}},
    "points": "p24",
    "start_time_stamp": "{{sungrow_diag_start}}",
    "end_time_stamp": "{{sungrow_diag_end}}",
    "minute_interval": 5
  }
}

script:pre-request {
  if (!bru.getVar('sungrow_diag_inv_keys'))
    bru.setVar('sungrow_diag_inv_keys', JSON.stringify(['6165627_1_2_3', '6165627_1_1_3']));
  // Ultimo bloque de 2 h que pide el backend para la vista "Diario" de HOY:
  // fechaFin llega como "yyyy-mm-dd" -> strtotime = 00:00, +12 h de "holgura"
  // = 12:00. El backend NUNCA pide nada despues de las 12:00 del dia.
  const pad = n => String(n).padStart(2, '0');
  const d = new Date();
  const ymd = d.getFullYear() + pad(d.getMonth() + 1) + pad(d.getDate());
  if (!bru.getVar('sungrow_diag_start')) bru.setVar('sungrow_diag_start', ymd + '100000');
  if (!bru.getVar('sungrow_diag_end')) bru.setVar('sungrow_diag_end', ymd + '120000');
}

script:post-response {
  const rd = res.body.result_data || {};
  Object.keys(rd).forEach(k => {
    const rows = rd[k] || [];
    const wh = rows.reduce((s, r) => s + Number(r.p24 || 0) * 5 / 60, 0);
    const nz = rows.filter(r => Number(r.p24) > 0);
    console.log(`${k}: ${rows.length} filas, ultima ${rows.length ? rows[rows.length - 1].time_stamp : '-'}, ` +
      `no nulas ${nz.length}, max ${Math.max(0, ...rows.map(r => Number(r.p24 || 0)))} W, ~${Math.round(wh)} Wh`);
  });
}

tests {
  test("un inversor devuelve serie plana a 0 y el otro la curva real", () => {
    const maxs = Object.values(res.body.result_data).map(rows => Math.max(0, ...rows.map(r => Number(r.p24 || 0))));
    expect(Math.min(...maxs)).to.equal(0);
    expect(Math.max(...maxs)).to.be.above(0);
  });
}

docs {
  Misma consulta que hace SungrowService::serieIntradia() para el ultimo bloque
  de la vista Diario, pero con LOS DOS inversores.

  1. El backend solo pide el primer ps_key (Inverter2), que devuelve 0.0 en
     cada muestra: grafica plana y "Analisis energetico 0,00 kWh".
  2. time_stamp esta en hora LOCAL de la planta (la ultima fila coincide con el
     reloj de Canarias), no en +08:00; la holgura de +/-12 h no hace falta, y
     como el fin se calcula como 00:00 + 12 h, la tarde no se pide nunca.

  CORREGIDO 2026-10-21: el backend pide todos los inversores y suma por
  time_stamp, y una fecha sola es el dia entero (000000-235959, o hasta ahora).
}
