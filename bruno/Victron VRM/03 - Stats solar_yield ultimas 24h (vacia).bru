meta {
  name: 03 - Stats solar_yield ultimas 24h (vacia)
  type: http
  seq: 3
}

get {
  url: {{base_url_vrm}}/installations/{{vrm_site_id}}/stats?type=solar_yield&interval=hours&start={{vrm_start_24h}}&end={{vrm_now}}
  body: none
  auth: none
}

headers {
  x-authorization: {{vrm_token}}
}

script:pre-request {
  const now = Math.floor(Date.now() / 1000);
  bru.setVar('vrm_now', now);
  bru.setVar('vrm_start_24h', now - 86400);
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Issue 2: la serie esta vacia porque NO HAY datos recientes, no porque falte el equipo", () => {
    expect(res.body.records.Pb).to.equal(false);
    expect(res.body.records.Pc).to.equal(false);
  });
}
