meta {
  name: 05 - Stats kwh total historico (interval years)
  type: http
  seq: 5
}

get {
  url: {{base_url_vrm}}/installations/{{vrm_site_id}}/stats?type=kwh&interval=years&start={{vrm_syscreated}}&end={{vrm_now_total}}
  body: none
  auth: none
}

headers {
  x-authorization: {{vrm_token}}
}

script:pre-request {
  bru.setVar('vrm_now_total', Math.floor(Date.now() / 1000));
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("Issue 3: el total historico real es > 0 kWh (Pb + Pc), no 0", () => {
    const t = res.body.totals;
    expect(t.Pb + t.Pc).to.be.above(10);
  });
}
