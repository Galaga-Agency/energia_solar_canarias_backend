meta {
  name: 06 - Overallstats kwh (sin total historico)
  type: http
  seq: 6
}

get {
  url: {{base_url_vrm}}/installations/{{vrm_site_id}}/overallstats?type=kwh
  body: none
  auth: none
}

headers {
  x-authorization: {{vrm_token}}
}

assert {
  res.status: eq 200
  res.body.success: eq true
}

tests {
  test("overallstats solo trae year/month/week/today, todos vacios: no sirve como total historico", () => {
    expect(Object.keys(res.body.records).sort()).to.eql(["month","today","week","year"]);
    expect(res.body.records.year.totals.kwh).to.equal(false);
  });
}
