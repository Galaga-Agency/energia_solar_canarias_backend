# PHPStan — analisis estatico. Cubre ISO 27001:2022 A.8.28 (codificacion segura).
#
# Analisis bloqueante en CI. El baseline conserva solo avisos anteriores; los
# nuevos errores hacen fallar el workflow y los arreglados se quitan del baseline.
parameters:
    level: 4
    paths:
        - app
        - index.php
    # Los .php de app/pages usan $theme que define index.php al incluirlos:
    # no es un error real, se documenta con /** @var string $theme */ en cada pagina.

# Baseline generado el 2026-10-15 con los 101 avisos que ya habia: se ignoran
# esos y fallan solo los NUEVOS. Al arreglar uno, regenera el baseline:
#   vendor/bin/phpstan analyse --memory-limit=1G --generate-baseline
includes:
    - phpstan-baseline.neon
